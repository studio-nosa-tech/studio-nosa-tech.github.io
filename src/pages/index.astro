---
import PageLayout from '../layouts/PageLayout.astro';
import logo from '../assets/logo.png';
import wallpaper from '../assets/wallpaper.webp';
import release from '../data/release.json';

const available = release.availability === 'available';
const newsSlug = release.release.replace(/\./g, '-');
---

<PageLayout
  title="ZIGNOS — Beyond the Limits."
  description="ゼロからビルドする、ソースベースの Linux ディストリビューション。最小ベース、zpkg、OpenRC、ローリングリリース。"
>
  <div class="wrap">
    <section class="hero">
      <div>
        <span class="eyebrow">ZIGNOS PROJECT</span>
        <h1>ZIGNOS</h1>
        <p class="tagline">Beyond the Limits.</p>
        <p class="catch">Engineered for Performance. Designed for Independence.</p>
        <p class="lead">
          ゼロからビルドする、ソースベースの Linux ディストリビューション。
          必要最小限のベースに、Go 製パッケージマネージャ
          <strong>zpkg</strong> と OpenRC を組み合わせています。必要なものは、自分で選んで入れる。
        </p>
        <div class="buttons">
          <a class="btn primary" href="/docs/">ドキュメントを読む</a>
          <a class="btn muted" href="/download/" aria-disabled={!available}>
            {available ? 'stage3 をダウンロード' : 'stage3 は準備中'}
          </a>
        </div>
        <p class="byline">
          Developed by <a href="https://studio-nosa.live/" rel="external">Studio NØSa.</a>
        </p>
      </div>
      <div class="hero-art">
        <img src={logo.src} alt="ZIGNOS ロゴ" width="520" height="336" />
      </div>
    </section>

    <section class="section" aria-label="ベースシステムの規模">
      <div class="stats">
        <div class="stat"><strong>{release.base.closure}</strong><span>ベースパッケージ(依存込み)</span></div>
        <div class="stat"><strong>{release.base.top_level}</strong><span>base.list のトップレベル</span></div>
        <div class="stat"><strong>BIOS / UEFI</strong><span>両ファームウェア対応</span></div>
        <div class="stat"><strong>OpenRC + zpkg</strong><span>init とパッケージ管理</span></div>
      </div>
    </section>

    <figure class="keyvisual">
      <img
        src={wallpaper.src}
        alt="ZIGNOS — Zenith Innovation for Next-generation Operating Systems。Beyond the Limits."
        width="1672"
        height="941"
        loading="lazy"
      />
      <figcaption>
        <span>ZIGNOS — Independent Linux Operating System</span>
        <a href="/wallpaper.png" download>壁紙をダウンロード (PNG, 1672×941)</a>
      </figcaption>
    </figure>

    <section class="section">
      <h2>設計</h2>
      <p class="section-lead">
        「基本はどの端末でも起動、細部は個人で弄る」。
        <a href="/what-is-zignos/">ZIGNOSとは。 →</a>
      </p>
      <div class="grid">
        <article class="card">
          <span class="icon">◆</span>
          <h3>ソースベース</h3>
          <p>
            レシピはシェルスクリプト。ビルドフラグも依存も自分で決められ、
            binpkg キャッシュで再ビルドを速くできます。
          </p>
        </article>
        <article class="card">
          <span class="icon">◆</span>
          <h3>ローリングリリース</h3>
          <p>
            各チャンネル(stable / testing / unstable)の HEAD が現在のリリース。
            <code>zpkg upgrade</code> が変更内容を示し、確認してから追従します。
          </p>
        </article>
        <article class="card">
          <span class="icon">◆</span>
          <h3>最小ベース</h3>
          <p>
            必要最小限のベース。エディタも SSH も最初からは入りません。
            必要なものを <code>zpkg install</code> で。
          </p>
        </article>
        <article class="card">
          <span class="icon">◆</span>
          <h3>BIOS / UEFI</h3>
          <p>
            <code>grub</code> の USE フラグで <code>bios</code> / <code>uefi</code> を選択。
            initramfs が <code>root=UUID=</code> を解決します。
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="release">
        <span class="tag">STABLE</span>
        <div>
          <h3>ZIGNOS {release.release}</h3>
          <p>
            stage3 {release.stage3.revision} · {release.stage3.package_count} パッケージ / {release.stage3.size_mib} MiB · {release.build_date}
            {available ? '' : ' (公開準備中)'}
          </p>
        </div>
        <a class="btn" href={`/news/${newsSlug}/`}>リリースノート</a>
      </div>
    </section>

    <section class="section">
      <h2>はじめ方</h2>
      <p class="section-lead">
        stage3 は展開して chroot し、その中でカーネルとブートローダーを導入します。
      </p>
      <div class="grid">
        <article class="card">
          <h3>1. 展開</h3>
          <p><code>tar -xpf zignos-stage3-*.tar.xz -C /mnt/zignos</code></p>
        </article>
        <article class="card">
          <h3>2. chroot</h3>
          <p><code>zignos-enter.sh /mnt/zignos</code></p>
        </article>
        <article class="card">
          <h3>3. カーネルと GRUB</h3>
          <p><code>zpkg install linux grub</code></p>
        </article>
      </div>
      <p style="margin-top: 1.2rem">
        <a href="/docs/install/">stage3 からのインストール手順を読む →</a>
      </p>
    </section>
  </div>
</PageLayout>
