---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="404 — ZIGNOS"
  description="ページが見つかりません。"
>
  <div class="wrap">
    <section class="page-hero">
      <span class="eyebrow">404</span>
      <h1>ページが見つかりません</h1>
      <p>URL が変わったか、削除された可能性があります。</p>
      <div class="buttons">
        <a class="btn primary" href="/">トップへ戻る</a>
        <a class="btn muted" href="/docs/">ドキュメントを読む</a>
      </div>
    </section>
  </div>
</PageLayout>
