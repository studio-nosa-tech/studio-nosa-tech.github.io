---
import PageLayout from '../../../layouts/PageLayout.astro';
import release from '../../../data/release.json';

const available = release.availability === 'available';
const assetBase = `https://github.com/studio-nosa-tech/zignos-recipes/releases/download/${release.release}`;
const releasePage = `https://github.com/studio-nosa-tech/zignos-recipes/releases/tag/${release.release}`;
---

<PageLayout
  lang="en"
  title={`ZIGNOS ${release.release} — ZIGNOS`}
  description={`Release notes for ZIGNOS ${release.release}. stage3 ${release.stage3.revision}, ${release.stage3.package_count} packages, zpkg ${release.zpkg.version}.`}
>
  <div class="wrap">
    <section class="page-hero">
      <span class="eyebrow">RELEASE · STABLE</span>
      <h1>ZIGNOS {release.release}</h1>
      <p>{release.build_date}</p>
    </section>

    <div class="prose">
      <div class="notice">
        <strong>stage3 downloads are {available ? 'available.' : 'not yet available.'}</strong>
        {' '}Artifacts can be obtained from the <a href="/en/download/">Download page</a> and
        <a href={releasePage}>GitHub Releases</a>.
        File names, sizes and SHA-256 values are collected in
        <a href="/en/releases/current/">Current release</a> and
        <a href="/releases.json">release.json</a>.
      </div>

      <h2>This release</h2>
      <p>
        {release.release} is a stage3 that updates the stable channel's base system
        to the latest recipes. As the first official release, it publishes the stage3
        tarball, recipe tree and zpkg binary on GitHub Releases.
        stage3 r21, published as 2026.11.24-alpha, has been renamed to the official
        2026.11.24.
      </p>
      <div class="stats">
        <div class="stat">
          <strong>{release.stage3.package_count}</strong>
          <span>stage3 packages</span>
        </div>
        <div class="stat">
          <strong>{release.stage3.size_mib} MiB</strong>
          <span>stage3 size</span>
        </div>
        <div class="stat">
          <strong>{release.stage3.revision}</strong>
          <span>stage3 revision</span>
        </div>
        <div class="stat">
          <strong>zpkg {release.zpkg.version}</strong>
          <span>Package manager</span>
        </div>
      </div>

      <h2>Highlights</h2>
      <ul>
        <li>
          <strong>Base updates</strong> — includes Linux headers 6.18.65, OpenSSL 4.0.3,
          xz 5.8.4, shadow 4.20.4, linux-pam r5 and zpkg 0.3.4-r4
        </li>
        <li>
          <strong>locales</strong> — added the <code>locales</code> package, which
          generates <code>en_US.UTF-8</code> and <code>ja_JP.UTF-8</code>, to the base
        </li>
        <li>
          <strong>Go 1.27.4</strong> — bundles the Go toolchain needed for source
          builds in stage3
        </li>
        <li>
          <strong>stage3 cleanup</strong> — excludes build directories and test roots
          from the tarball, so it contains only the base system
        </li>
      </ul>

      <h2>Artifacts</h2>
      <table>
        <thead>
          <tr><th>Artifact</th><th>File</th><th>Size</th></tr>
        </thead>
        <tbody>
          {release.artifacts.map((a) => (
            <tr>
              <td>{a.name}</td>
              <td><a href={`${assetBase}/${a.filename}`}><code>{a.filename}</code></a></td>
              <td>{a.size.toLocaleString('en-US')} bytes</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mono">
        stage3 SHA-256: <code class="hash">{release.stage3.sha256}</code>
      </p>

      <h2>Installation</h2>
      <pre><code>tar -xpf {release.stage3.filename} -C /mnt/zignos
# Mount /dev /proc /sys /run and chroot
chroot /mnt/zignos /bin/bash -l
passwd
zpkg install linux grub</code></pre>
      <p>
        For the procedure, including partitioning, UEFI GRUB registration and initial
        configuration, see the <a href="/en/docs/install/">installation guide</a>.
      </p>

      <h2>Links</h2>
      <ul>
        <li><a href="/en/download/">Download</a></li>
        <li><a href={releasePage}>GitHub Releases</a></li>
        <li><a href="/en/releases/current/">Current release</a></li>
        <li><a href="/en/docs/stage3/">stage3 guide</a></li>
        <li><a href="/en/docs/channels/">Release channels</a></li>
      </ul>
    </div>
  </div>
</PageLayout>
