---
import PageLayout from '../../layouts/PageLayout.astro';
import release from '../../data/release.json';

const newsSlug = release.release.replace(/\./g, '-');
---

<PageLayout
  title="ニュース — ZIGNOS"
  description="ZIGNOS のリリース情報とプロジェクトの更新。"
>
  <div class="wrap">
    <section class="page-hero">
      <span class="eyebrow">NEWS</span>
      <h1>ニュース</h1>
      <p>リリース情報とプロジェクトの更新をまとめます。</p>
    </section>

    <div class="post-list">
      <a class="post-card" href={`/news/${newsSlug}/`}>
        <time datetime={release.build_date}>{release.build_date}</time>
        <h2>ZIGNOS {release.release}</h2>
        <p>
          stage3 {release.stage3.revision} は
          {release.stage3.package_count} パッケージ / {release.stage3.size_mib} MiB、
          zpkg {release.zpkg.version}。stable ベースを最新化し、locales と
          Go ツールチェーンを収録した初の一般配布版です。
        </p>
      </a>
      <a class="post-card" href="/news/2026-11-19-alpha/">
        <time datetime="2026-11-19">2026-11-19</time>
        <h2>ZIGNOS 2026.11.19-alpha</h2>
        <p>
          リリースマニフェストの導入。stage3 r12 は 54 パッケージ / 977 MiB、
          zpkg 0.2.0。
        </p>
      </a>
      <a class="post-card" href="/news/2026-11-17-alpha/">
        <time datetime="2026-11-17">2026-11-17</time>
        <h2>ZIGNOS 2026.11.17-alpha</h2>
        <p>
          初の alpha リリース。stage3 tarball の公開に向けて準備中です。
        </p>
      </a>
    </div>
  </div>
</PageLayout>
